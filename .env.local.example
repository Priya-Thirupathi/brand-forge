# Copy to .env.local (gitignored) and fill in. See TRD.md §12 for the full reference table.

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgresql://brandforge:brandforge@localhost:5434/brandforge
# A second database for integration tests (`npm run test:integration`) — create it once with
# `docker exec <db container> psql -U brandforge -d brandforge -c "CREATE DATABASE brandforge_test"`,
# then `DATABASE_URL="$TEST_DATABASE_URL" npm run migrate` to apply migrations to it too.
TEST_DATABASE_URL=postgresql://brandforge:brandforge@localhost:5434/brandforge_test

# Salt for hashing client IPs before storing them (rate limiting; TRD.md §10) — never store the
# raw IP. Any random string of 16+ characters; generate one with `openssl rand -hex 16`.
IP_HASH_SALT=

# --- Gemini (production provider, D2 — free-tier project, no billing account attached) ---
GEMINI_API_KEY=
MODEL_STRONG=gemini-3.8-flash
MODEL_CHEAP=gemini-3.5-flash-lite

# --- Rate limits (TRD.md §10, D16) ---
RATE_LIMIT_GENERATE_PER_HOUR=10
GLOBAL_DAILY_GENERATION_CAP=50

# --- Local-dev-only alternate provider (D26) ---
# Uncomment to test against Qwen (via Groq's free tier) instead of Gemini, so repeated local
# testing doesn't spend Gemini's daily quota. Never takes effect in a production build
# (app/api/generate/route.ts's createLlmClient checks NODE_ENV) regardless of these being set.
# LOCAL_LLM_PROVIDER=qwen
# GROQ_API_KEY=
# MODEL_STRONG=qwen/qwen3.8-27b
# MODEL_CHEAP=qwen/qwen3.8-27b

# --- Eval harness (Stage 2, TRD.md §9/§10, D27) ---
# Shared secret between `npm run eval` and this target's POST /api/generate. Unset means this
# target accepts no eval traffic at all (the safe default for a deployed public demo).
EVAL_TOKEN=
# Judge model, deliberately a different tier than MODEL_STRONG. Defaults to gemini-3.5-flash-lite,
# or (in local Qwen dev mode only) MODEL_CHEAP, since Groq exposes no separate "cheap" model.
JUDGE_MODEL=
# The CLI's own pacing against --target, independent of RATE_LIMIT_GENERATE_PER_HOUR above
# (eval traffic bypasses that limit entirely — see D27).
EVAL_TARGET_RPM=6
