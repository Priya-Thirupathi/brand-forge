# Copy to .env.local (gitignored) and fill in. See TRD.md §12 for the full reference table.

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgresql://brandforge:brandforge@localhost:5434/brandforge
# A second database for integration tests (`npm run test:integration`) — create it once with
# `docker exec <db container> psql -U brandforge -d brandforge -c "CREATE DATABASE brandforge_test"`,
# then `DATABASE_URL="$TEST_DATABASE_URL" npm run migrate` to apply migrations to it too.
TEST_DATABASE_URL=postgresql://brandforge:brandforge@localhost:5434/brandforge_test

# --- LLM provider (D2, D26) ---
# Qwen via Groq's free tier is the default — both this example and the live production deploy use
# it, since Gemini's daily quota kept getting exhausted (D2's 2026-09-20 revision). Works in any
# environment (lib/adapters/createLlmClient.ts).
LLM_PROVIDER=qwen
GROQ_API_KEY=
MODEL_STRONG=qwen/qwen3.8-27b
MODEL_CHEAP=qwen/qwen3.8-27b

# --- Rate limit (TRD.md §10, D16) ---
# The only admission control: a rolling-24h cap on generations, counted across every source.
# 166 = Groq's qwen/qwen3.8-27b free-tier RPD (1,000) ÷ 6. Lower this if you switch to Gemini below
# (unset LLM_PROVIDER) — Gemini's daily quota is smaller than Groq's, see D26. Eval runs count
# toward it too, so a full fixture pass eats a real share of the day's budget.
GLOBAL_DAILY_GENERATION_CAP=166

# --- Alternate provider: Gemini (D2, D26) ---
# Uncomment to use Gemini instead of Qwen, and comment out (or unset) LLM_PROVIDER above.
# GEMINI_API_KEY=
# MODEL_STRONG=gemini-3.8-flash
# MODEL_CHEAP=gemini-3.5-flash-lite

# --- Eval harness (Stage 2, TRD.md §9/§10, D27) ---
# Shared secret between `npm run eval` and this target's POST /api/generate. Unset means this
# target accepts no eval traffic at all (the safe default for a deployed public demo).
EVAL_TOKEN=
# Judge model, deliberately a different tier than MODEL_STRONG. Defaults to gemini-3.5-flash-lite,
# or (when LLM_PROVIDER=qwen) MODEL_CHEAP, since Groq exposes no separate "cheap" model.
JUDGE_MODEL=
# The CLI's own pacing against --target. Eval traffic is never *blocked* by the daily cap above
# (D27), but its runs are counted toward it, so this pacing is what keeps a fixture pass from
# outrunning the provider's own per-minute limit.
EVAL_TARGET_RPM=6

# --- Response cache (Stage 5 item 6, D34) ---
# Exact-match cache is on by default: an identical idea + category + option returns the stored
# result instead of spending three model calls. Set to `off` for a live demo where every
# submission should really generate. Eval traffic ignores it either way.
GENERATION_CACHE=
